# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/mystorage

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# Storage Provider: "r2" | "s3" | "local" (local for development only)
STORAGE_PROVIDER=local

# Cloudflare R2 (when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# AWS S3 (when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Local storage path (when STORAGE_PROVIDER=local)
LOCAL_STORAGE_PATH=./uploads

# Upload limits
MAX_FILE_SIZE_MB=500
DEFAULT_STORAGE_LIMIT_GB=20

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
